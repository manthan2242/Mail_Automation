# JWT_SECRET: Secret for signing JWT tokens
JWT_SECRET="your-jwt-secret-here"

# Public App Configuration
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Sales Force Pro"
NEXT_PUBLIC_FROM_EMAILS="email1@example.com,email2@example.com"
NEXT_PUBLIC_DEFAULT_DOMAINS="gmail.com,yahoo.com,outlook.com"

# OTP Configuration
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRY_MINUTES=5

# SMTP Configuration (for OTP and system emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user-here"
SMTP_PASS="your-smtp-password-here"
EMAIL_USER="your-smtp-user-here"
EMAIL_PASS="your-smtp-password-here"

# AI Model Configuration
AI_MODEL_NAME="gemini-2.0-flash"
GEMINI_API_KEY="your-gemini-api-key-here"

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Application URL (Internal)
APP_URL="http://localhost:3000"

# Email Configuration
FROM_EMAIL="noreply@example.com"

# Test Configuration
TEST_EMAIL="test@example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="AdminPassword123"
EMPLOYEE_EMAIL="employee@example.com"
EMPLOYEE_PASSWORD="EmployeePassword123"
