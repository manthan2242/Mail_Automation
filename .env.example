# JWT_SECRET: Secret for signing JWT tokens
JWT_SECRET="your-super-secret-key"

# SMTP Configuration (for OTP and system emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"

# OpenAI/Gemini API Key
# NEXT_PUBLIC_GEMINI_API_KEY is already injected by AI Studio

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Application Config
NEXT_PUBLIC_DEFAULT_SENDER="hr.sambhavai@gmail.com"
NEXT_PUBLIC_SYSTEM_EMAIL="admin@system.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@salesforcepro.com"
NEXT_PUBLIC_APP_NAME="Sales Force Pro"

# Seed / Initial Configuration
SYSTEM_ADMIN_EMAIL="admin@mail.com"
SYSTEM_ADMIN_PASSWORD="Admin@123"
SAMPLE_EMPLOYEE_EMAIL="employee@mail.com"
SAMPLE_EMPLOYEE_PASSWORD="Employee@123"


