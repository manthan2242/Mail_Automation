generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String?   @default("email")
  twoFactorSecret  String?
  backupCodes      String?
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  apiKeys          ApiKey[]
}

model Employee {
  id               String       @id @default(uuid())
  email            String       @unique
  username         String       @unique
  password         String
  name             String
  isFirstLogin     Boolean      @default(true)
  twoFactorEnabled Boolean      @default(false)
  failedAttempts   Int          @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  emails           Email[]
  assignments      EmailAssignment[]
  userAiKeys       UserAiKey[]
  assignedProjects Project[]         @relation("EmployeeProjects")
  attendanceLogs   AttendanceLog[]
}

// Per-employee AI provider API keys
model UserAiKey {
  id           String   @id @default(uuid())
  employeeId   String
  provider     String   // "openai" | "gemini" | "groq" | "claude" | "openrouter"
  hashedKey    String
  maskedKey    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, provider]) // One key per provider per employee
}

model EmailConfig {
  id          String            @id @default(uuid())
  name        String            @default("Mail Automation")
  host        String
  port        Int
  email       String            @unique
  password    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  emails      Email[]
  assignments EmailAssignment[]
}

model EmailAssignment {
  id             String      @id @default(uuid())
  employeeId     String
  emailAccountId String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  emailAccount   EmailConfig @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([employeeId, emailAccountId])
}

model Email {
  id            String       @id @default(uuid())
  to            String?
  cc            String?
  bcc           String?
  fromEmail     String?
  subject       String
  body          String
  status        String       @default("PENDING")
  senderId      String?
  adminSenderId String?
  configId      String?
  adminComment  String?
  attachments   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  config        EmailConfig? @relation(fields: [configId], references: [id], onDelete: Cascade)
  employee      Employee?    @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Admin-level API keys (for external integrations)
model ApiKey {
  id        String   @id @default(uuid())
  name      String
  hashedKey String   @unique
  maskedKey String
  isActive  Boolean  @default(true)
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminMailHistory {
  id        String   @id @default(uuid())
  to        String
  cc        String?
  bcc       String?
  subject   String
  body      String
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?
}

model Client {
  id            String    @id @default(uuid())
  name          String
  primaryMail   String    @unique
  secondaryMail String?
  optionalMail  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
  targets       Target[]
}

model Project {
  id         String   @id @default(uuid())
  name       String
  shortName  String?
  shortName2 String?
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  targets           Target[]
  assignedEmployees Employee[] @relation("EmployeeProjects")

  @@unique([clientId, name])
}

model Target {
  id           String   @id @default(uuid())
  clientId     String
  projectId    String
  mailCount    Int
  frequency    String   // "DAILY" | "WEEKLY" | "MONTHLY"
  currentCount Int      @default(0)
  isCompleted  Boolean  @default(false)
  lastReset    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
}

model AttendanceLog {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn        DateTime  @default(now())
  clockOut       DateTime?
  clockInImage   String?
  clockOutImage  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
